# کلیدهای پروژه Supabase
# این فایل را به secrets.properties کپی کنید و مقادیر خود را بگذارید.
# فایل secrets.properties در .gitignore است و روی گیت نمی‌رود.
#
# مقادیر را از اینجا بردارید:
#   Supabase Dashboard → Project Settings → API
#
# ⚠️ فقط کلید anon public را بگذارید، نه service_role

SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
